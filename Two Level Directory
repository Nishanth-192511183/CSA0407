#include <stdio.h>

int main()
{
    int users, files;

    printf("Enter number of users: ");
    scanf("%d",&users);

    for(int i=0;i<users;i++)
    {
        printf("\nUser %d\n",i+1);

        printf("Enter number of files: ");
        scanf("%d",&files);

        char name[20];

        for(int j=0;j<files;j++)
        {
            printf("Enter file %d: ",j+1);
            scanf("%s",name);
        }
    }

    printf("\nTwo Level Directory Created Successfully\n");

    return 0;
}
