#include <stdio.h>
int main(){
    int block[20], n, i;
    printf("Enter number of file blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("\nFile Allocation\n");
printf("First Block: %d\n", block[0]);
    printf("Last Block: %d\n", block[n - 1]);
    printf("Linked Blocks: ");
    for(i = 0; i < n; i++)
    {
        printf("%d", block[i]);
        if(i < n - 1)
            printf(" -> ");}
    printf(" -> NULL\n");
    return 0;
}
