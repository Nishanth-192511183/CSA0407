#include<stdio.h>
int main(){
int b[10],p[10],a[10];
int n,m,i,j,k;
printf("Enter number of blocks: ");
scanf("%d",&n);
printf("Enter block sizes:\n");
for(i=0;i<n;i++)
scanf("%d",&b[i]);
printf("Enter number of processes: ");
scanf("%d",&m);
printf("Enter process sizes:\n");
for(i=0;i<m;i++){
scanf("%d",&p[i]);
a[i]=-1;
}
for(i=0;i<m;i++)
{
k=-1;
for(j=0;j<n;j++)
{
if(b[j]>=p[i]){
if(k==-1)
k=j;
else if(b[j]<b[k])
k=j;
}
}
if(k!=-1)
{
a[i]=k;
b[k]=b[k]-p[i];
}
}
printf("\nProcess\tSize\tBlock\n");
for(i=0;i<m;i++)
{
printf("P%d\t%d\t",i+1,p[i]);
if(a[i]==-1)
printf("Not Allocated\n");
else
printf("B%d\n",a[i]+1);}

return 0;
}
