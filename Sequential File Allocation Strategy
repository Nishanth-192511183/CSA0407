#include <stdio.h>
int main(){
    int n, i, pos;
    char file[20][30];
    printf("Enter number of records: ");
    scanf("%d", &n);
    for(i = 0; i < n; i++)
    {
        printf("Enter record %d: ", i + 1);
        scanf("%s", file[i]);}
    printf("\nEnter record number to access: ");
    scanf("%d", &pos);
    printf("\nRecords accessed:\n");
    for(i = 0; i < pos; i++)
        printf("Record %d: %s\n", i + 1, file[i]);
    return 0;
}
