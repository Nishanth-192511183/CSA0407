#include<stdio.h>
#include<pthread.h>
int x=0;
pthread_mutex_t m;
void *fun(void *a)
{
int i;
for(i=0;i<5;i++)
{
pthread_mutex_lock(&m);
x=x+1;
printf("Thread %ld value %d\n",(long)a,x);
pthread_mutex_unlock(&m);
}
}
int main()
{
pthread_t t1,t2;
pthread_mutex_init(&m,0);
pthread_create(&t1,0,fun,(void *)1);
pthread_create(&t2,0,fun,(void *)2);
pthread_join(t1,0);
pthread_join(t2,0);
printf("Final value = %d",x);
return 0;
}
