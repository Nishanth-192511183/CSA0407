#include<stdio.h>

int main()
{
int n,m,i,j,k,c=0,x;
int a[10][10],ma[10][10],ne[10][10],av[10],f[10],ans[10];

printf("Enter number of processes: ");
scanf("%d",&n);
printf("Enter number of resources: ");
scanf("%d",&m);
printf("Enter allocation matrix:\n");
for(i=0;i<n;i++)
for(j=0;j<m;j++)
scanf("%d",&a[i][j]);
printf("Enter maximum matrix:\n");
for(i=0;i<n;i++)
for(j=0;j<m;j++)
scanf("%d",&ma[i][j]);

printf("Enter available resources:\n");
for(i=0;i<m;i++)
scanf("%d",&av[i]);
for(i=0;i<n;i++)
{
f[i]=0;
for(j=0;j<m;j++)
ne[i][j]=ma[i][j]-a[i][j];
}

while(c<n)
{
x=0;
for(i=0;i<n;i++)
{
if(f[i]==0)
{
for(j=0;j<m;j++)
if(ne[i][j]>av[j])
break;
if(j==m)
{
for(k=0;k<m;k++)
av[k]=av[k]+a[i][k];

ans[c]=i;
c++;
f[i]=1;
x=1;
}
}
}

if(x==0)
break;
}

if(c==n)
{
printf("System is in safe state\n");
printf("Safe sequence: ");

for(i=0;i<n;i++)
{
printf("P%d",ans[i]);
if(i<n-1)
printf(" -> ");
}
}
else
printf("System is not in safe state");
return 0;
}
