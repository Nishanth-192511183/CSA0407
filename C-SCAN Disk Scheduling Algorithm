#include <stdio.h>
#include <stdlib.h>
int main()
{
    int req[20], n, head, size, i, j, temp;
    int movement = 0;
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter request queue:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    printf("Enter disk size: ");
    scanf("%d", &size);
    for(i = 0; i < n - 1; i++)
    {
  for(j = i + 1; j < n; j++){
            if(req[i] > req[j])
            {
                temp = req[i];
                req[i] = req[j];
                req[j] = temp;
            }
        }}
    printf("\nDisk Scheduling Order:\n");
    printf("%d", head);
    for(i = 0; i < n; i++)
    {
        if(req[i] >= head)
        {
            movement += abs(head - req[i]);
            head = req[i];
            printf(" -> %d", head);
        }
    }
    movement += abs(head - (size - 1));
    head = size - 1;
    printf(" -> %d", head);
    movement += head;
    head = 0;
    printf(" -> %d", head);
    for(i = 0; i < n; i++){
        if(req[i] < head)
        {
            movement += abs(head - req[i]);
            head = req[i];
            printf(" -> %d", head);
        }}
    printf("\nTotal Head Movement = %d cylinders\n", movement);
    return 0;
}
